---
// The client's official badge logo, used as-is: src/assets/brand/logo-badge.png
// (copy of 02-assets/brand/logo_circular_tourguide.png). The band inside the ring is
// transparent in the source file, so it sits on a white disc to look identical on
// light and dark backgrounds.
import { Image } from 'astro:assets';
import badge from '../assets/brand/logo-badge.png';
interface Props {
  class?: string;
  size?: number; // rendered diameter in px
}
const { class: cls = '', size = 64 } = Astro.props;
---
<span class={`inline-flex shrink-0 rounded-full bg-white ${cls}`} style={`width:${size}px;height:${size}px`}>
  <Image src={badge} alt="Tour Guide Ecuador" width={size} height={size}
         densities={[1, 2, 3]} loading="eager" class="h-full w-full" />
</span>
