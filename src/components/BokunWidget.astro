---
import { SITE } from '../lib/site';
/*
  Bókun day-tour booking widget shell.
  Real bookings render once the client supplies each experience's Bókun ID
  (frontmatter `bokunExperienceId`) and the channel UUID (Site settings → Bókun booking
  channel UUID, or the PUBLIC_BOKUN_CHANNEL_ID env var).
  Until then we show a clean "request to book" placeholder so the page is complete.
*/
interface Props { experienceId?: string; title?: string }
const { experienceId, title = 'this tour' } = Astro.props;
const channelId = SITE.bokunChannelId;
const ready = Boolean(experienceId && channelId);
const bookText = `Hi! I'd like to book ${title}.`;
---
{ready ? (
  <>
    <div class="bokunWidget" data-src={`https://widgets.bokun.io/online-sales/${channelId}/experience-calendar/${experienceId}`}></div>
    <script is:inline data-astro-rerun>
      // Page transitions swap <body>, but Bókun boots once per page load and keeps watching the
      // old body (it skips booting when these globals exist). Clear them so the loader below
      // boots a fresh widget on this page.
      delete window.__BokunWidgetsLoader;
      delete window.BokunWidgets;
    </script>
    <script is:inline async data-astro-rerun src={`https://widgets.bokun.io/assets/javascripts/apps/build/BokunWidgetsLoader.js?bookingChannelUUID=${channelId}`}></script>
    <script is:inline data-astro-rerun>
      // Safety net: Bókun booted but this widget didn't start (e.g. Bókun changed how it boots) —
      // reload once so a normal page load takes over. Slow networks don't trigger it: the check
      // only fires once Bókun itself has loaded.
      (() => {
        const path = location.pathname;
        setTimeout(() => {
          const w = document.querySelector('.bokunWidget');
          if (!w || !window.BokunWidgets || w.hasAttribute('data-bokun-widget-loaded') || location.pathname !== path) return;
          try {
            if (sessionStorage.getItem('bokun-reloaded') === path) return;
            sessionStorage.setItem('bokun-reloaded', path);
          } catch (e) { return; }
          location.reload();
        }, 4000);
      })();
    </script>
    <p class="mt-3 text-center text-xs text-ink-500">
      Questions first? <a href={`https://wa.me/${SITE.whatsappNumber}?text=${encodeURIComponent(bookText)}`} target="_blank" rel="noopener" class="font-medium text-brand-600 hover:underline">WhatsApp us</a>
    </p>
    <noscript><a class="btn btn-primary w-full" href={`https://wa.me/${SITE.whatsappNumber}`}>Enquire to book</a></noscript>
  </>
) : (
  <div class="rounded-2xl border border-dashed border-brand-300 bg-brand-50/60 p-6 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Online booking opening soon</p>
    <p class="mt-2 text-sm text-ink-600">
      Live availability &amp; instant booking for {title} are being set up. For now, reserve in
      minutes — we reply fast.
    </p>
    <a href={`https://wa.me/${SITE.whatsappNumber}?text=${encodeURIComponent(bookText)}`}
       target="_blank" rel="noopener" class="btn btn-primary mt-4 w-full">Request to book</a>
    <a href="/contact-us" class="mt-2 inline-block text-sm font-medium text-brand-600 hover:underline">or send an enquiry →</a>
  </div>
)}
